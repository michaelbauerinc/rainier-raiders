{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rainier Raiders website values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "replicaCount",
    "nameOverride",
    "fullnameOverride",
    "image",
    "imagePullSecrets",
    "existingSecrets",
    "serviceAccountName",
    "config",
    "service",
    "ingress",
    "podAnnotations",
    "terminationGracePeriodSeconds",
    "resources",
    "probes",
    "storage",
    "nodeSelector",
    "tolerations",
    "affinity"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "nameOverride": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "fullnameOverride": {
      "type": "string",
      "maxLength": 63,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\s@]+$"
        },
        "tag": {
          "type": "string",
          "pattern": "^$|^[a-zA-Z0-9_][a-zA-Z0-9_.-]{0,127}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
          }
        }
      }
    },
    "existingSecrets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253,
        "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
      }
    },
    "serviceAccountName": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
    },
    "config": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
        "not": {
          "enum": [
            "PORT",
            "HOSTNAME",
            "NODE_ENV"
          ]
        }
      },
      "properties": {
        "WEBSITE_MODE": {
          "type": "string",
          "enum": [
            "preview",
            "full"
          ]
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "host",
        "gateway"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^([a-z0-9]([-a-z0-9]*[a-z0-9])?\\.)+[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "gateway": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "not": {
          "enum": [
            "checksum/config"
          ]
        }
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 30
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startup",
        "readiness",
        "liveness"
      ],
      "properties": {
        "startup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "failureThreshold",
            "periodSeconds",
            "timeoutSeconds"
          ],
          "properties": {
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "failureThreshold",
            "periodSeconds",
            "timeoutSeconds"
          ],
          "properties": {
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "liveness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "failureThreshold",
            "periodSeconds",
            "timeoutSeconds"
          ],
          "properties": {
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cacheSizeLimit",
        "tmpSizeLimit"
      ],
      "properties": {
        "cacheSizeLimit": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9]+(\\.[0-9]+)?([KMGTPE]i?|m)?$"
        },
        "tmpSizeLimit": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9]+(\\.[0-9]+)?([KMGTPE]i?|m)?$"
        }
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ingress": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "ingress": {
            "properties": {
              "host": {
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
