# Copy to .env.local for host development. Docker Compose supplies its own DATABASE_URL.
DATABASE_URL=postgres://rainier:local-development-only@127.0.0.1:5432/rainier_raiders
DB_POOL_MAX=5

# Discord setup TODO: login remains disabled until all required fields are valid.
# Local callback: http://localhost:3000/api/auth/callback/discord
# Use this same origin in your browser and Discord OAuth application.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# Comma-separated Discord role/user snowflake IDs. Owners still need guild membership.
DISCORD_EDITOR_ROLE_IDS=
DISCORD_OWNER_IDS=

# Optional, destructive integration tests use a separate local database ending in _test.
# TEST_DATABASE_URL=postgres://rainier:local-development-only@127.0.0.1:5432/rainier_raiders_test
